# Cursor API key(必填)。从 https://cursor.com/dashboard 创建。
CURSOR_API_KEY=

# 可选:HTTP 监听。默认 127.0.0.1:3000。
# HOST=127.0.0.1
# PORT=3000

# 可选:访问令牌。配置后须经登录页写入 cookie 才能访问任意路径。
# 监听非本机回环且未配置此项时,启动会打醒目告警。
# AUTH_TOKEN=

# 可选:https 部署时给鉴权 cookie 加 Secure 标志(http 局域网不要开)。
# AUTH_COOKIE_SECURE=1

# 可选:企微智能机器人桥接(npm run wecom)。与主服务读同一 AUTH_TOKEN。
# WECOM_BOT_ID=
# WECOM_SECRET=
# WECOM_CWD=/path/to/workspace
# WECOM_BASE_URL=http://127.0.0.1:3000
