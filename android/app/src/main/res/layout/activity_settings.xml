<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/settings_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#f7f7f4"
    android:orientation="vertical">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/settings_toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#f7f7f4"
        android:theme="@style/ThemeOverlay.AppCompat.ActionBar"
        app:navigationIcon="?attr/homeAsUpIndicator"
        app:title="@string/shell_settings"
        app:titleTextColor="#1a1a1a" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/origin_title"
                android:textColor="#1a1a1a"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/origin_message"
                android:textColor="#555555"
                android:textSize="13sp" />

            <LinearLayout
                android:id="@+id/origin_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/origin_add_title"
                android:textColor="#1a1a1a"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/origin_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="@string/origin_hint"
                android:inputType="textUri"
                android:singleLine="true" />

            <EditText
                android:id="@+id/origin_basic_user"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="@string/http_auth_user"
                android:inputType="text"
                android:singleLine="true" />

            <EditText
                android:id="@+id/origin_basic_pass"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="@string/http_auth_pass"
                android:inputType="textPassword"
                android:singleLine="true" />

            <Button
                android:id="@+id/origin_add"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/origin_add" />

            <Button
                android:id="@+id/http_auth_save"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:backgroundTint="#e8e8e4"
                android:text="@string/http_auth_save"
                android:textColor="#1a1a1a" />

            <Button
                android:id="@+id/page_reload"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:backgroundTint="#e8e8e4"
                android:text="@string/menu_reload"
                android:textColor="#1a1a1a" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
